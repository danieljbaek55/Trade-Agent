# Copy this to .env and fill in your Alpaca credentials.
# Get these from https://app.alpaca.markets → API Keys (Paper Trading section).
# NEVER commit your actual .env file to git.

ALPACA_API_KEY=your_api_key_here
ALPACA_API_SECRET=your_api_secret_here

# Optional — email trade alerts via SMTP.
# For Gmail: enable 2FA on your Google account, then create an App Password
# at https://myaccount.google.com/apppasswords and use it below (NOT your real password).
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_TO=        # where to send alerts; defaults to EMAIL_USERNAME

# Override these only if not using Gmail
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587

# Set to 1 to force synthetic demo data even when Alpaca is configured.
TRADE_AGENT_DEMO=0
