# Copy this to .env and fill in your Alpaca credentials.
# Get these from https://app.alpaca.markets → API Keys (Paper Trading section).
# NEVER commit your actual .env file to git.

ALPACA_API_KEY=your_api_key_here
ALPACA_API_SECRET=your_api_secret_here

# Set to 1 to force synthetic demo data even when Alpaca is configured.
TRADE_AGENT_DEMO=0
